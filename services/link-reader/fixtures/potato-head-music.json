cription":null,"MenuOrder":3,"sitemap_exclude":null},{"id":24,"Name":"Klymax","Slug":"klymax","createdAt":"2024-08-30T07:53:08.978Z","updatedAt":"2026-09-23T05:03:40.837Z","publishedAt":"2026-06-30T09:23:34.921Z","Description":null,"MenuOrder":3,"sitemap_exclude":false}],"Location":{"id":28,"Name":"Klymax","Slug":"klymax-discotheque","Address":"Desa Potato Head Bali, Jl. Petitenget No.51B, Seminyak, Kec. Kuta Utara, Kabupaten Badung, Bali 80361"},"FAQS":null,"Products":{"id":168,"Title":null},"Itinerary":null,"Carousel":null,"seo":null,"Contents":[{"__component":"contents.banner","id":396,"Title":"Live at Klymax: OFFSCRIPT","ShowDatePlace":true,"Description":"Live at Klymax is a series exploring live performance in a club environment, bringing together musicians, electronic instruments and visual artists.\n\nFollowing a September debut that brought more than 500 people to Klymax, OFFSCRIPT is back for its December edition.\n\nBorn in Bali, OFFSCRIPT brings together a rotating cast of musicians, vocalists and DJs, exploring the space between live improvisation and club culture.\n\nNo script. No fixed setlists.\n\nMoving through jazz, soul, techno, UK garage, house, broken beat and drum & bass, the musicians play with the instinct of DJs, building tension and finding grooves. Every session takes its own shape, guided as much by the room as by the players.\n\nJazz instinct. Club energy.\n\n\\\nFriday, 11 December 2026\n\n9PM–3AM\n\nKlymax, Desa Potato Head, Bali\n\n\\\nEarly bird tickets are limited and on sale now."},{"__component":"contents.line-up","id":206,"Title":"Line-up Profile","Type":"carousel","Subtitle":"","VariantCard":"artist-rounded"},{"__component":"contents.gallery","id":172,"Title":"Gallery","Summary":null,"Type":"Default"},{"__component":"contents.products","id":169,"Title":null},{"__component":"contents.one-third-column","id":502,"SectionTitle":null,"Title":"Details","Description":"**Type**\n\\\nMusic, Klymax\n\n\n**Klymax**\n\\\nDesa Potato Head Bali, Jl. Petitenget No.51B, Seminyak, Kec. Kuta Utara, Kabupaten Badung, Bali 80361","StyleTitle":"Bold","Type":"Two-Column","NoPaddingTop":false,"NoPaddingBottom":false}],"createdBy":{"id":34,"firstname":"Danica","lastname":"Massie","username":null,"email":"danica.massie@potatohead.co","password":"$2a$10$syKGQ1N6LLVGNCltd3bOX.tWlmcN4Sonb109u0PLPYe2VRWNQfS3q","resetPasswordToken":null,"registrationToken":null,"isActive":true,"blocked":false,"preferedLanguage":null,"createdAt":"2025-01-15T03:11:35.108Z","updatedAt":"2025-10-23T00:24:21.385Z"},"updatedBy":{"id":34,"firstname":"Danica","lastname":"Massie","username":null,"email":"danica.massie@potatohead.co","password":"$2a$10$syKGQ1N6LLVGNCltd3bOX.tWlmcN4Sonb109u0PLPYe2VRWNQfS3q","resetPasswordToken":null,"registrationToken":null,"isActive":true,"blocked":false,"preferedLanguage":null,"createdAt":"2025-01-15T03:11:35.108Z","updatedAt":"2025-10-23T00:24:21.385Z"},"DateStart":"2026-12-11T13:00:00.000Z","DateEnd":"2026-12-10T19:00:00.000Z","RecurringDates":["2026-12-11T13:00:00.000Z"],"isRecurring":false,"scheduleId":34051},{"id":1019,"Type":"Event","Title":"NYE 2026","Excerpt":"Celebrate New Year's Eve 2026 at Desa Potato Head Bali.\n","Slug":"new-years-eve","createdAt":"2026-09-25T11:50:57.353Z","updatedAt":"2026-11-19T07:50:55.274Z","publishedAt":"2026-09-30T05:18:10.286Z","Description":"New Year's Eve in Bali is fast approaching and we’re already making plans to mark the occasion. We’ll be celebrating one of our favourite nights of the year with a curated line-up of international and resident DJs, representing the diverse nature of global dance music and paying tribute to the boundary-pushing, cutting edge of sound.\n\nAmsterdam’s rightly-lauded Job Jobse brings a joy-driven approach to music that moves from house and techno to disco and acid, culture-bending Irish DJ Saoirse goes back to back with the UK’s Motor City-reimagining Shanti Celeste, and sonic master craftsman Leon Vynehall returns to Potato Head with his characteristically ambitious take on electronic music. \n\nJoined by local favourites and Klymax residents, this year’s NYE lineup is bolstered by sounds for the archipelago's thriving scene. Dita and Gero bring their eclectic tastes and kinetic energy to the dancefloor, while Daffabedamned and Marvel promise immersive and wide-ranging sounds that lift the room in celebration. \n\nWith a full stage and an extended dancefloor, [Potato Head Beach Club](https://seminyak.potatohead.co/feast/beach-club) will once again shift gears and give artists and partiers more space to make the night their own. Join us as we ring in 2026 with a day-to-night party, celebrating the high-water mark of contemporary club music on the shores of our home in Seminyak.","sitemap_exclude":false,"HideDateStart":false,"HideDateEnd":true,"Schedule":[{"dates":["2026-12-31","2027-01-01"],"endTime":"02:00","location":2,"startTime":"16:00","isRecurring":false}],"TicketSoldOut":false,"SubCategory":null,"Locale":null,"Information":"","IptvCta":null,"HideMoreButton":false,"Pinned":true,"IsShowThumbnail":null,"TagPrice":null,"ShowOnExperience":null,"Thumbnail":{"id":4867,"name":"New Year Eve - NYE 2026 - Potato Head 16x9.jpg","alternativeText":null,"caption":null,"width":1920,"height":1080,"formats":{"large":{"ext":".jpg","url":"https://cdn.potatohead.co/large_New_Year_Eve_NYE_2026_Potato_Head_16x9_65b55abc14.jpg","hash":"large_New_Year_Eve_NYE_2026_Potato_Head_16x9_65b55abc14","mime":"image/jpeg","name":"large_New Year Eve - NYE 2026 - Potato Head 16x9.jpg","path":null,"size":162.77,"width":1000,"height":563},"small":{"ext":".jpg","url":"https://cdn.potatohead.co/small_New_Year_Eve_NYE_2026_Potato_Head_16x9_65b55abc14.jpg","hash":"small_New_Year_Eve_NYE_2026_Potato_Head_16x9_65b55abc14","mime":"image/jpeg","name":"small_New Year Eve - NYE 2026 - Potato Head 16x9.jpg","path":null,"size":44.38,"width":500,"height":281},"medium":{"ext":".jpg","url":"https://cdn.potatohead.co/medium_New_Year_Eve_NYE_2026_Po