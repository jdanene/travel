{
  /*
   * Realtime Database rules for the trip app. The contract is section 4 of
   * docs/trip-app/plan.md; web/src/lib/paths.ts builds the same paths, and
   * web/tests/rules.test.ts holds the two together.
   *
   * Words used below:
   *   "its member"   the member id this device points to:
   *                  trips/$tripId/crew/devices/<auth.uid>
   *   "an organizer" a device listed under trips/$tripId/crew/organizers
   *
   * The scripts in scripts/ write info, crew/expected, the starting
   * dates/options, parties/lastYear, places, tripSecrets/organizerKey and
   * tripSecrets/admins with admin rights, so no rule below lets a phone
   * write them. The exceptions are places/custom, a friend's place from
   * "Add to map"; info/inviteTitle, which an organizer sets with
   * "Edit invite" and create-trip leaves alone; and a new
   * tripSecrets/organizerKey entry, which an organizer adds with
   * "Add an organizer" and create-trip keeps.
   */
  "rules": {
    "trips": {
      "$tripId": {
        ".read": "auth != null",

        "info": {
          "inviteTitle": {
            /* The name in the link preview; scripts/stamp-preview.mjs writes it into the page files at deploy time. */
            ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
          }
        },

        "crew": {
          "members": {
            "$memberId": {
              ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() === $memberId",
              ".validate": "newData.hasChildren(['name', 'reply', 'at'])",
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
              "reply": { ".validate": "newData.isString() && newData.val().matches(/^(in|maybe|out)$/)" },
              "at": { ".validate": "newData.isNumber()" },
              /* Optional: the member's own photo, a small JPEG data URL (no Firebase Storage on the free plan). */
              "photo": { ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 30000" },
              "$other": { ".validate": false }
            }
          },
          "devices": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,40}$/)"
            }
          },
          "organizers": {
            "$uid": {
              /* A device becomes an organizer by the key of the organizer link, or by a verified
                 email on the admin list: tripSecrets/$tripId/admins/<email, lower case, "." as ","> (D15). */
              ".write": "auth != null && auth.uid === $uid && ((root.child('tripSecrets').child($tripId).child('claims').child(auth.uid).exists() && root.child('tripSecrets').child($tripId).child('organizerKey').child(root.child('tripSecrets').child($tripId).child('claims').child(auth.uid).val()).exists()) || (auth.token.email_verified === true && root.child('tripSecrets').child($tripId).child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))",
              ".validate": "newData.val() === true"
            }
          }
        },

        "dates": {
          "options": {
            "$optionId": {
              /* A friend adds an option under its member, never over one that exists; the adder or an organizer removes one that is not confirmed. The page offers Remove only while nobody else has voted on it. */
              ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() !== null && ((!data.exists() && newData.child('addedBy').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val()) || (data.exists() && !newData.exists() && (data.child('addedBy').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() || root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true) && root.child('trips').child($tripId).child('dates').child('confirmed').child('optionId').val() !== $optionId))",
              /* The season is fixed: 1 Feb to 31 Mar 2027 (owner). The id is the two days, so one range is one option. */
              ".validate": "newData.hasChildren(['from', 'to', 'addedBy', 'at']) && newData.child('from').val() <= newData.child('to').val() && $optionId === newData.child('from').val() + '_' + newData.child('to').val()",
              "from": { ".validate": "newData.isString() && newData.val().matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)" },
              "to": { ".validate": "newData.isString() && newData.val().matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)" },
              "addedBy": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "answers": {
            "$optionId": {
              /* Removing an option takes its answers with it, in the same write, by whoever may remove the option. */
              ".write": "auth != null && !newData.exists() && !newData.parent().parent().child('options').child($optionId).exists() && (root.child('trips').child($tripId).child('dates').child('options').child($optionId).child('addedBy').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() || root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true)",
              "$memberId": {
                ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() === $memberId",
                /* newData, not root: an option and its adder's Yes arrive in one write. */
                ".validate": "newData.isString() && newData.val().matches(/^(yes|maybe|no)$/) && newData.parent().parent().parent().child('options').child($optionId).exists()"
              }
            }
          },
          "confirmed": {
            /* An organizer confirms where nothing is confirmed, or undoes the confirm; so of two organizers the first wins (case 11). */
            ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true && (!data.exists() || !newData.exists())",
            ".validate": "newData.hasChildren(['optionId', 'by', 'at']) && root.child('trips').child($tripId).child('dates').child('options').child(newData.child('optionId').val()).exists()",
            "optionId": { ".validate": "newData.isString()" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "stay": {
          "options": {
            "$stayId": {
              ".write": "auth != null && !data.exists() && newData.child('addedBy').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val()",
              /* A place sits in any city (owner, 24 Nov 2026); a destination is set only when the city is one of the trip's. Its dates are optional. */
              ".validate": "$stayId.length <= 200 && newData.hasChildren(['url', 'name', 'area', 'addedBy', 'at']) && (!newData.child('destination').exists() || root.child('trips').child($tripId).child('info').child('destinations').child(newData.child('destination').val()).exists()) && (!newData.child('to').exists() || (newData.child('from').exists() && newData.child('from').val() <= newData.child('to').val()))",
              "destination": { ".validate": "newData.isString()" },
              "city": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
              "from": { ".validate": "newData.isString() && newData.val().matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)" },
              "to": { ".validate": "newData.isString() && newData.val().matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)" },
              "url": { ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().beginsWith('https://')" },
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
              "area": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
              "sleeps": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
              "photoUrl": { ".validate": "newData.isString() && newData.val().length <= 1000 && newData.val().beginsWith('https://')" },
              "addedBy": { ".validate": "newData.isString()" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "hearts": {
            "$stayId": {
              "$memberId": {
                ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() === $memberId",
                ".validate": "newData.val() === true && root.child('trips').child($tripId).child('stay').child('options').child($stayId).exists()"
              }
            }
          },
          "confirmed": {
            "$destination": {
              /* As for the dates: a confirm only where none stands, or an undo (case 20). */
              ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true && (!data.exists() || !newData.exists())",
              ".validate": "newData.hasChildren(['stayId', 'by', 'at']) && root.child('trips').child($tripId).child('stay').child('options').child(newData.child('stayId').val()).child('destination').val() === $destination",
              "stayId": { ".validate": "newData.isString()" },
              "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },

        "links": {
          "items": {
            "$linkId": {
              /* A friend adds a link under its member; the adder or an organizer edits its destination and note, or removes it. The address and the adder never change. */
              ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).exists() && ((!data.exists() && newData.child('addedBy').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val()) || (data.exists() && (data.child('addedBy').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() || root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true) && (!newData.exists() || (newData.child('url').val() === data.child('url').val() && newData.child('addedBy').val() === data.child('addedBy').val()))))",
              ".validate": "$linkId.length <= 200 && newData.hasChildren(['url', 'site', 'destination', 'addedBy', 'at']) && root.child('trips').child($tripId).child('info').child('destinations').child(newData.child('destination').val()).exists()",
              "url": { ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().beginsWith('https://')" },
              "site": { ".validate": "newData.isString() && newData.val().matches(/^(instagram|tiktok|other)$/)" },
              "destination": { ".validate": "newData.isString()" },
              "note": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "title": { ".validate": "newData.isString() && newData.val().length <= 300" },
              "thumbUrl": { ".validate": "newData.isString() && newData.val().length <= 1000 && newData.val().beginsWith('https://')" },
              "addedBy": { ".validate": "newData.isString()" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },
        "places": {
          "tagNames": {
            /* A tag's name. Any member makes a new one when tagging an event (owner, 24 Nov 2026: "anyone should be able to add or remove tags"); a name never changes once made. */
            "$tag": {
              ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).exists() && !data.exists()",
              ".validate": "$tag.matches(/^[a-z0-9-]{1,24}$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            }
          },
          "custom": {
            "$placeId": {
              /* A friend adds a place under its member, anywhere in the world (owner, 24 Nov 2026); its destination is the trip's nearest one, for grouping. The adder or an organizer removes it. No edits. */
              ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).exists() && ((!data.exists() && newData.child('addedBy').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val()) || (data.exists() && (data.child('addedBy').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() || root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true) && (!newData.exists() || (newData.child('url').val() === data.child('url').val() && newData.child('addedBy').val() === data.child('addedBy').val()))))",
              ".validate": "$placeId.length <= 200 && newData.hasChildren(['name', 'kind', 'destination', 'lat', 'lng', 'addedBy', 'at']) && root.child('trips').child($tripId).child('info').child('destinations').child(newData.child('destination').val()).exists()",
              "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
              "kind": { ".validate": "newData.isString() && newData.val().matches(/^(event|food|beach|activity|other)$/)" },
              "destination": { ".validate": "newData.isString()" },
              "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
              "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
              "link": { ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().beginsWith('https://')" },
              "description": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
              "photo": { ".validate": "newData.isString() && newData.val().length <= 80000 && newData.val().beginsWith('data:image/jpeg;base64,')" },
              "addedBy": { ".validate": "newData.isString()" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },
        "activity": {
          "$id": {
            /* One line of the Activity list (design: mockups/crew/5). A member writes a line under its own member, once:
               no edits. The daily events check writes "event-found" with no member. The author or an organizer
               deletes a line: a post or a poll from the Feed (its votes and replies go in the same write), or an
               automatic line when its thing is removed (owner, 24 Nov 2026: going out or deleting a link takes its line). */
            ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() !== null && ((!data.exists() && (newData.child('by').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() || (newData.child('kind').val() === 'event-found' && !newData.child('by').exists()))) || (data.exists() && !newData.exists() && (data.child('by').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() || root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true)))",
            ".validate": "$id.length <= 40 && newData.hasChildren(['kind', 'at']) && ((newData.child('kind').val() !== 'post' && newData.child('kind').val() !== 'poll') || newData.hasChild('text') || (newData.child('kind').val() === 'post' && newData.hasChild('gif'))) && ((newData.child('kind').val() === 'poll') === newData.child('options').exists()) && (newData.child('kind').val() !== 'poll' || newData.child('options').hasChildren(['0', '1']))",
            "kind": { ".validate": "newData.isString() && newData.val().matches(/^(joined|reply-changed|dates-added|dates-confirmed|dates-changed|stay-added|stay-confirmed|event-added|event-in|link-added|place-added|event-found|post|poll)$/)" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "at": { ".validate": "newData.isNumber()" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500" },
            "ref": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "options": {
              "$i": { ".validate": "$i.matches(/^[0-3]$/) && newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" }
            },
            /* A GIF or sticker post: the picture stays on KLIPY's media host, as its terms ask; the size keeps its place. */
            "gif": { ".validate": "newData.isString() && newData.val().length <= 400 && newData.val().matches(/^https:\\/\\/static\\.klipy\\.com\\/[A-Za-z0-9_.\\/-]+$/) && newData.parent().child('kind').val() === 'post'" },
            "gifW": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4000" },
            "gifH": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4000" },
            "$other": { ".validate": false }
          }
        },
        "activityVotes": {
          "$id": {
            /* Deleting a poll takes its votes with it, by whoever may delete the poll. */
            ".write": "auth != null && !newData.exists() && !newData.parent().parent().child('activity').child($id).exists() && (root.child('trips').child($tripId).child('activity').child($id).child('by').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() || root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true)",
            "$memberId": {
              /* A member's vote on a poll: the option's index. It can change, or be taken back. */
              ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() === $memberId",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3 && newData.parent().parent().parent().child('activity').child($id).child('options').child('' + newData.val()).exists()"
            }
          }
        },
        "activityReactions": {
          "$id": {
            /* Deleting a post or a poll takes its emoji with it, by whoever may delete it. */
            ".write": "auth != null && !newData.exists() && !newData.parent().parent().child('activity').child($id).exists() && (root.child('trips').child($tripId).child('activity').child($id).child('by').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() || root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true)",
            "$memberId": {
              /* A member's emoji on a Feed line, as on Discord: several, each added or taken off on its own, under the
                 member's own id, on a line that exists. The key is the emoji's Twemoji code points or a 7TV emote
                 (features/activity/lib/reactions.ts, REACTION_KEY); the value is the time it was added. */
              ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() === $memberId",
              ".validate": "newData.hasChildren() && root.child('trips').child($tripId).child('activity').child($id).exists()",
              "$key": { ".validate": "$key.matches(/^([0-9a-f]{1,6}(-[0-9a-f]{1,6}){0,9}|7tv-[0-9A-HJKMNP-TV-Z]{26}-[A-Za-z0-9_():-]{1,40})$/) && newData.isNumber()" }
            }
          }
        },
        "activityReplies": {
          "$id": {
            /* Deleting a line takes its replies with it, by whoever may delete it. */
            ".write": "auth != null && !newData.exists() && !newData.parent().parent().child('activity').child($id).exists() && (root.child('trips').child($tripId).child('activity').child($id).child('by').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() || root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true)",
            "$replyId": {
              /* A reply under any feed line (owner, 24 Nov 2026), under the member's own name, once: no edits. */
              ".write": "auth != null && !data.exists() && newData.child('by').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val()",
              ".validate": "$replyId.length <= 40 && newData.hasChildren(['by', 'at']) && (newData.hasChild('text') || newData.hasChild('gif')) && root.child('trips').child($tripId).child('activity').child($id).exists()",
              "by": { ".validate": "newData.isString()" },
              "at": { ".validate": "newData.isNumber()" },
              "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500" },
              /* A GIF or sticker reply: on KLIPY's host only, as a GIF post. */
              "gif": { ".validate": "newData.isString() && newData.val().length <= 400 && newData.val().matches(/^https:\\/\\/static\\.klipy\\.com\\/[A-Za-z0-9_.\\/-]+$/)" },
              "gifW": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4000" },
              "gifH": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4000" },
              "$other": { ".validate": false }
            }
          }
        },
        "parties": {
          "shows": {
            "$showId": {
              /* A friend adds a show under its member; the adder or an organizer edits or removes it.
                 The events check adds a show nobody added: new only, not confirmed, with its https link. */
              ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).exists() && ((!data.exists() && newData.child('addedBy').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() && newData.child('source').val() === 'friend') || (!data.exists() && newData.child('source').val() === 'check' && !newData.child('addedBy').exists() && newData.child('verified').val() === true && newData.child('link').isString() && newData.child('link').val().beginsWith('https://')) || (data.exists() && (data.child('addedBy').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() || root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true)))",
              ".validate": "$showId.length <= 200 && newData.hasChildren(['destination', 'venue', 'date', 'artist', 'verified', 'source', 'at']) && root.child('trips').child($tripId).child('info').child('destinations').child(newData.child('destination').val()).exists() && (!data.exists() || newData.child('addedBy').val() === data.child('addedBy').val()) && (!data.exists() || newData.child('source').val() !== 'check' || data.child('source').val() === 'check')",
              "destination": { ".validate": "newData.isString()" },
              "venue": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
              "area": { ".validate": "newData.isString() && newData.val().length <= 60" },
              /* Events run 25 Jan to 31 Mar 2027 (owner: the last week of January has Zamna); the date poll keeps 1 Feb to 31 Mar. */
              "date": { ".validate": "newData.isString() && newData.val().matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)" },
              "weekly": { ".validate": "newData.isString() && newData.val().matches(/^(mon|tue|wed|thu|fri|sat|sun)$/)" },
              "artist": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
              "about": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
              "link": { ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().matches(/^https?:\\/\\//)" },
              /* The event's own picture (the artist or line-up flyer the club publishes), from the events check or its backfill. */
              "photoUrl": { ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().beginsWith('https://')" },
              "verified": { ".validate": "newData.isBoolean()" },
              "source": { ".validate": "newData.isString() && newData.val().matches(/^(seed|friend|check)$/)" },
              "addedBy": { ".validate": "newData.isString()" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "showTags": {
            /* An event's tags (owner, 24 Nov 2026: "no club tags"; "anyone should be able to add or remove tags"). Any member adds or removes one; the seed gives "big" once. */
            ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).exists()",
            "$showId": {
              "$tag": { ".validate": "$tag.matches(/^[a-z0-9-]{1,24}$/) && newData.val() === true && newData.parent().parent().parent().child('shows').child($showId).exists()" }
            }
          },
          "lastCheck": {
            /* The last events check: a member claims it in a transaction, so one device runs it. It only moves forward. */
            ".write": "auth != null && newData.exists() && newData.child('by').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val()",
            ".validate": "newData.hasChildren(['at', 'by']) && (!data.exists() || newData.child('at').val() > data.child('at').val())",
            "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "by": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          },
          "in": {
            "$showId": {
              /* Removing a show takes its "in" marks with it, in the same write. */
              ".write": "auth != null && !newData.exists() && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).exists() && (root.child('trips').child($tripId).child('parties').child('shows').child($showId).child('addedBy').val() === root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() || root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true)",
              "$memberId": {
                ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() === $memberId",
                ".validate": "newData.val() === true && root.child('trips').child($tripId).child('parties').child('shows').child($showId).exists()"
              }
            }
          }
        }
      }
    },

    "tripSecrets": {
      "$tripId": {
        "organizerKey": {
          "$key": {
            /* An organizer makes a new organizer link ("Add an organizer"): create only, never over a key, never a removal.
               No rule lets a phone read a key, so no device can list them. */
            ".write": "auth != null && !data.exists() && root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true",
            ".validate": "newData.val() === true && $key.matches(/^[A-Za-z0-9_-]{16,64}$/)"
          }
        },
        "claims": {
          "$uid": {
            /* A device writes its own claim; only a key that exists is accepted. */
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{16,64}$/) && root.child('tripSecrets').child($tripId).child('organizerKey').child(newData.val()).exists()"
          }
        },
        "phones": {
          /* A member's phone for trip texts. An organizer reads them all (for "Text the crew"; the sender
             services/travel-texts reads them with the organizer's token). A member's own device reads,
             writes and removes its own entry. Nobody else reads one: friends never see each other's numbers. */
          ".read": "auth != null && root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true",
          "$memberId": {
            ".read": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() === $memberId",
            ".write": "auth != null && root.child('trips').child($tripId).child('crew').child('devices').child(auth.uid).val() === $memberId",
            ".validate": "newData.hasChildren(['e164', 'at'])",
            "e164": { ".validate": "newData.isString() && newData.val().matches(/^\\+[1-9][0-9]{7,14}$/)" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "textLog": {
          /* The trip's texts per day (UTC), which the sender counts against its cap of 5 a day. It writes with
             the organizer's token, so an organizer may write; the count only goes up by one and stops at 5,
             and nobody can remove a day, so a page cannot reset the cap. */
          ".read": "auth != null && root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true",
          "$day": {
            ".write": "auth != null && newData.exists() && root.child('trips').child($tripId).child('crew').child('organizers').child(auth.uid).val() === true",
            ".validate": "$day.matches(/^20[0-9]{2}-[01][0-9]-[0-3][0-9]$/) && newData.hasChildren(['texts', 'at']) && ((!data.exists() && newData.child('texts').val() === 1) || (data.exists() && newData.child('texts').val() === data.child('texts').val() + 1)) && newData.child('texts').val() <= 5",
            "texts": { ".validate": "newData.isNumber()" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
